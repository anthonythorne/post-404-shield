{
	"name": "anthonythorne/post-404-shield-dev",
	"description": "Development environment (linting, static analysis, tests) for the Post 404 Shield must-use plugin. Not shipped.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/anthonythorne/post-404-shield",
	"support": {
		"issues": "https://github.com/anthonythorne/post-404-shield/issues",
		"source": "https://github.com/anthonythorne/post-404-shield"
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.6",
		"php-stubs/wp-cli-stubs": "^2.10",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"test:pure": "php tests/pure/shield-pure-functions.test.php",
		"check": [
			"@lint",
			"@analyse",
			"@test",
			"@test:pure"
		]
	}
}
